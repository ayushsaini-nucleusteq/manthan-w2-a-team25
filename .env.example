# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Database
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Backend auth: HS256 JWT signing key, at least 32 random bytes (e.g. `openssl rand -base64 48`).
# Leave empty to get a random key per start (tokens then stop working after a restart).
JWT_SECRET=

# Shared password for all seeded demo users (docs/demo-accounts.md). Put the real value only in .env.
SEED_USER_PASSWORD=change-me-demo-password

# Browser origin(s) allowed by backend CORS, comma-separated
FRONTEND_ORIGIN=http://localhost:5173

# Host ports
BACKEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# FRONTEND_PORT=5173
